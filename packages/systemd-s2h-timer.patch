diff --git a/src/sleep/sleep-timer.c b/src/sleep/sleep-timer.c
new file mode 100644
index 0000000..0e685e5
--- /dev/null
+++ b/src/sleep/sleep-timer.c
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <errno.h>
+#include <poll.h>
+#include <sys/timerfd.h>
+
+#include "io-util.h"
+#include "log.h"
+#include "sleep-timer.h"
+#include "time-util.h"
+
+int sleep_timer_wait(int fd) {
+        struct itimerspec ts;
+        usec_t left, timeout = 0;
+
+        if (timerfd_gettime(fd, &ts) < 0)
+                return -errno;
+
+        left = timespec_load(&ts.it_value);
+
+        /* RTC alarms may wake the system slightly before the higher-resolution timerfd expires.
+         * An immediate poll then misclassifies the wakeup as manual and abandons hibernation.
+         * Allow up to one second for a timer whose deadline is already this close, matching the
+         * granularity of common RTC alarms. Do not wait for a distant deadline after a manual wakeup.
+         * A manual wakeup within this window may therefore be followed by hibernation as well.
+         * Keep polling for the actual event: do not hibernate before the timer has expired, and do
+         * not consume it here. Disarmed and already expired timers need only a nonblocking poll. */
+        if (left > 0 && left <= USEC_PER_SEC) {
+                timeout = USEC_PER_SEC;
+                log_debug("Suspend-then-hibernate timer expires in %s, allowing up to 1s for the timer event.",
+                          FORMAT_TIMESPAN(left, USEC_PER_MSEC));
+        }
+
+        return fd_wait_for_event(fd, POLLIN, timeout);
+}
