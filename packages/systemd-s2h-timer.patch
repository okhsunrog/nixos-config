diff --git a/src/sleep/test-sleep-timer.c b/src/sleep/test-sleep-timer.c
new file mode 100644
index 0000000..ad9c660
--- /dev/null
+++ b/src/sleep/test-sleep-timer.c
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <errno.h>
+#include <poll.h>
+#include <sys/timerfd.h>
+#include <unistd.h>
+
+#include "fd-util.h"
+#include "log.h"
+#include "macro.h"
+#include "sleep-timer.h"
+#include "time-util.h"
+
+static int new_timer(usec_t delay) {
+        struct itimerspec ts = {};
+        int fd;
+
+        fd = timerfd_create(CLOCK_BOOTTIME, TFD_NONBLOCK|TFD_CLOEXEC);
+        assert_se(fd >= 0);
+        timespec_store(&ts.it_value, delay);
+        assert_se(timerfd_settime(fd, 0, &ts, NULL) == 0);
+        return fd;
+}
+
+static void test_early_wakeup(void) {
+        /* The first two cases reproduce the measured hardware skew. Also cover a larger skew.
+         * Readiness must come from the real timerfd, rather than an inferred/rounded deadline. */
+        FOREACH_ELEMENT(delay, ((usec_t[]) { 28 * USEC_PER_MSEC, 125 * USEC_PER_MSEC, 750 * USEC_PER_MSEC })) {
+                _cleanup_close_ int fd = new_timer(*delay);
+                uint64_t expirations;
+                int r;
+
+                r = sleep_timer_wait(fd);
+                assert_se(r >= 0);
+                assert_se(FLAGS_SET(r, POLLIN));
+                assert_se(read(fd, &expirations, sizeof(expirations)) == sizeof(expirations));
+                assert_se(expirations == 1);
+        }
+}
+
+static void test_manual_wakeup(void) {
+        _cleanup_close_ int fd = new_timer(30 * USEC_PER_SEC);
+        usec_t before = now(CLOCK_MONOTONIC);
+
+        assert_se(sleep_timer_wait(fd) == 0);
+        assert_se(now(CLOCK_MONOTONIC) - before < USEC_PER_SEC / 2);
+}
+
+static void test_expired_timer(void) {
+        _cleanup_close_ int fd = new_timer(USEC_PER_MSEC);
+        int r;
+
+        assert_se(usleep_safe(20 * USEC_PER_MSEC) == 0);
+        r = sleep_timer_wait(fd);
+        assert_se(r >= 0);
+        assert_se(FLAGS_SET(r, POLLIN));
+}
+
+static void test_disarmed_timer(void) {
+        _cleanup_close_ int fd = new_timer(0);
+        usec_t before = now(CLOCK_MONOTONIC);
+
+        assert_se(sleep_timer_wait(fd) == 0);
+        assert_se(now(CLOCK_MONOTONIC) - before < USEC_PER_SEC / 2);
+}
+
+static void test_invalid_timer(void) {
+        assert_se(sleep_timer_wait(-1) == -EBADF);
+}
+
+int main(void) {
+        log_set_max_level(LOG_DEBUG);
+        log_setup();
+
+        test_early_wakeup();
+        test_manual_wakeup();
+        test_expired_timer();
+        test_disarmed_timer();
+        test_invalid_timer();
+
+        log_info("All sleep timer tests passed.");
+        return 0;
+}
